{
  "name": "wedding-seating-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "离线婚礼桌位编排器：宾客关系 + 真实场地布局，IndexedDB 本地存储，Worker 内 glpk.js 求解",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:logic": "tsx scripts/validate-logic.ts",
    "test:ui": "tsx scripts/smoke-ui.tsx",
    "test": "npm run test:logic && npm run test:ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "glpk.js": "^4.0.2",
    "konva": "^9.3.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
